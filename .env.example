# URL base del API Gateway (M1, Spring Cloud Gateway). Solo la usa el servidor Next (BFF);
# el navegador siempre habla con /bff/... del mismo origen.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# "enabled" levanta MSW en el servidor Next (instrumentation.ts) y simula el Gateway
# con los JSON de los contratos mientras los backends estan en desarrollo.
API_MOCKING=disabled
